FROM node:22-bookworm-slim AS frontend
WORKDIR /build
COPY apps/local-ai/frontend/package*.json ./
RUN npm ci --ignore-scripts
COPY apps/local-ai/frontend/ ./
RUN npm run build

FROM python:3.13-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY apps/local-ai/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY apps/local-ai/backend/ ./backend/
COPY apps/local-ai/config/ ./config/
COPY --from=frontend /build/dist/ ./frontend/dist/
RUN useradd --create-home --uid 10001 werkz && mkdir -p /app/data /app/.runtime && chown -R werkz:werkz /app
USER werkz
ENV WERKZ_AI_PACKAGE=hotel-demo WERKZ_AI_MODE=demo WERKZ_ONLINE_TEST=1
CMD ["sh", "-c", "exec uvicorn backend.app:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
