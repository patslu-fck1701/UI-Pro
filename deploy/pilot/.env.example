# WerkZ Einfach Pilot – never commit real values
WERKZ_TAX_ADVISER_EMAIL=steuerberater@example.invalid
WERKZ_DEMO_CRYPTO_SNAPSHOT=
# Crypto is off by default; enable only for the explicitly authorized primary demo tenant.
WERKZ_PILOT_CRYPTO_ENABLED=0
# Independent allowlist for the WerkZ owner's portfolio snapshot; requires crypto enabled too.
WERKZ_PILOT_OWNER_DEMO_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Incoming Voice is fail-closed until all three values below are configured.
# Use the exact public HTTPS origin Twilio calls; number map values are existing pilot tenant slugs.
WERKZ_TWILIO_AUTH_TOKEN=
WERKZ_PILOT_TWILIO_BASE_URL=https://example.invalid
WERKZ_PILOT_TWILIO_NUMBERS_JSON={}
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# JSON snapshot: {"source":"...","asOf":"ISO","items":[{"key":"mixed-scrap","label":"Mischschrott","unit":"EUR/t","price":210}]}
WERKZ_SCRAP_PRICE_SNAPSHOT=

# Abholungskalkulation – example defaults only, tune per customer/vehicle
# vehicleCostPerKm includes fuel/wear; values are not legal/tax mileage rates.
WERKZ_PICKUP_DEFAULTS={"vehicleCostPerKm":0.45,"handlingCostEur":15,"minimumProfitEur":50,"targetMarginPct":15,"vehiclePayloadKg":1200}


# Optional: additional completely isolated WERKZ – SCHROTTIES customer companies.
# Each organisationId is a hard tenant boundary for API data, files, exports and backups.
# loginCode/loginCodeHash are BOOTSTRAP ONLY. The customer replaces them inside the app with an own password.
# After a customer password exists, the bootstrap code is no longer accepted.
# Gmail addresses/passwords do NOT belong here; Gmail is selected by the customer in Google OAuth, iCloud is entered in the app.
WERKZ_PILOT_TENANTS_JSON=[{"id":"meyer","organisationId":"org-meyer-recycling","name":"Meyer Recycling","actorLabel":"Meyer","publicSlug":"meyer","loginCode":"ONE-TIME-BOOTSTRAP","loginCodeHash":"","accessExpiresAt":"","taxRecipient":"steuerbuero@example.de","cryptoEnabled":false,"ownerDemoEnabled":false}]

# Primary WERKZ – SCHROTTIES bootstrap login. The customer should replace it with an own password in the app.
WERKZ_PILOT_SLUG=primary
WERKZ_PILOT_BUSINESS_NAME=Mein Schrottbetrieb
WERKZ_PILOT_LOGIN_CODE=
# Alternative to a plaintext login code: SHA-256 of the normalized access code (uppercase, spaces removed).
WERKZ_PILOT_LOGIN_CODE_SHA256=
# Optional temporary access expiry (ISO-8601). Expired tenant sessions fail closed.
WERKZ_PILOT_ACCESS_EXPIRES_AT=
# Long random secret; keep stable across deploys so 60-day sessions survive restarts.
WERKZ_PILOT_SESSION_TOKEN=



# Runtime persistence root for the non-production file-backed pilot.
# On ephemeral hosts this is NOT production durability; use a persistent disk/volume when enabled.
WERKZ_TIME_DATA_DIR=./var/time-test
# Production guard: when enabled, the declared root must already exist and WERKZ_TIME_DATA_DIR must be inside it.
# This prevents accidental ephemeral startup but does not replace a real restart/backup/restore proof.
WERKZ_PILOT_REQUIRE_PERSISTENT_STORAGE=0
WERKZ_PILOT_PERSISTENT_ROOT=

# Shared persistent application database. When set, customer WerkZ password hashes and mail tokens use PostgreSQL instead of local files.
# Prefer Render's internal Postgres URL when the web service and DB are in the same region.
WERKZ_DATABASE_URL=

# Mail read access: encrypted token/app-password storage.
# The key must be a strong secret and must never be committed.
WERKZ_PILOT_MAIL_TOKEN_KEY=
# Legacy compatibility: WERKZ_MAIL_DATABASE_URL is also accepted when WERKZ_DATABASE_URL is unset.
WERKZ_MAIL_DATABASE_URL=
# Exact HTTPS callback configured once for the WerkZ Google OAuth web client.
# No customer Gmail address or Google password is configured here. The customer selects the Google account in the app.
WERKZ_PILOT_GMAIL_REDIRECT_URI=https://example.invalid/pilot/mail/google/callback

# Optional voice diagnostics allowlist: comma-separated tenant slugs or organisation IDs.
# Diagnostics are text/parse metadata only; no audio recording is created.
WERKZ_PILOT_VOICE_DIAGNOSTIC_ORGS=


# Legacy/generic Time test profiles are disabled on the Schrotties host.
# These flags are test-only and must stay off for a normal pilot/customer runtime.
WERKZ_ENABLE_TEST_PROFILES=0
WERKZ_ALLOW_EPHEMERAL_TEST_SECRETS=0
# WERKZ_TEST_SESSION_TOKEN and WERKZ_TEST_LOGIN_CODE are required only when
# WERKZ_ENABLE_TEST_PROFILES=1. They are not production Schrotties credentials.


# Optional real outbound mail for confirmed monthly tax-adviser handoff.
# BOTH values are required; partial configuration fails closed at startup.
# Keep the API key only in the deployment secret store. Example sender format:
# WERKZ_PILOT_OUTBOUND_FROM=WerkZ <belege@your-verified-domain.example>
# With both values empty the pilot stays in safe DraftMailProvider mode and sends nothing externally.
WERKZ_PILOT_RESEND_API_KEY=
WERKZ_PILOT_OUTBOUND_FROM=
