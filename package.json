{
  "name": "werkz-core",
  "version": "0.3.0",
  "private": true,
  "description": "WerkZ Handwerk deployment mirror",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/handwerk-sevdesk.test.js test/public-advisor-retirement.test.js test/public-handwerk-demo.test.js",
    "lint": "node tools/lint.js",
    "typecheck": "node tools/typecheck.js",
    "check": "node tools/deployment-preflight.js",
    "verify": "npm run check && npm run lint && npm run typecheck && npm test && npm run oss:check && npm run security:secrets",
    "time:test-server": "node tools/time-test-server.js",
    "sbom": "node tools/oss-audit.js --write",
    "oss:check": "node tools/oss-audit.js --check",
    "security:secrets": "node tools/secret-audit.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "imapflow": "^1.0.0",
    "pg": "^8.13.1"
  }
}
